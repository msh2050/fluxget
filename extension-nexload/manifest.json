{
  "manifest_version": 3,
  "name": "FluxGet",
  "description": "IDM-style download manager — intercepts browser downloads, captures video streams from YouTube, Vimeo, Twitch, and any site.",
  "version": "2.0.0",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "FluxGet Downloader"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "js": ["document.js"],
      "matches": ["*://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": ["content.js"],
      "matches": ["*://*/*"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "alarms",
    "contextMenus",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["*://*/*"],

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "document.js"],
      "matches": ["*://*/*"]
    }
  ]
}
